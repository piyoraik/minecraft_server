#!/bin/bash
set -euo pipefail

COMMAND="${1:-}"
if [[ -z "${COMMAND}" ]]; then
  echo "command argument is required" >&2
  exit 1
fi

case "${COMMAND}" in
  list|save-all|save-on|save-off|whitelist\ on|whitelist\ off|whitelist\ list|defaultgamemode\ survival|defaultgamemode\ creative|defaultgamemode\ adventure|defaultgamemode\ spectator)
    ;;
  say\ *|time\ set\ day|time\ set\ night|time\ set\ noon|time\ set\ midnight|weather\ clear|weather\ rain|weather\ thunder|difficulty\ peaceful|difficulty\ easy|difficulty\ normal|difficulty\ hard|whitelist\ add\ *|whitelist\ remove\ *|op\ *|deop\ *)
    ;;
  *)
    echo "command is not allowed" >&2
    exit 1
    ;;
esac

RCON_PASSWORD="$(awk -F= '/^rcon.password=/{print substr($0, index($0, "=") + 1)}' /home/minecraft/linuxgsm/serverfiles/server.properties)"
if [[ -z "${RCON_PASSWORD}" ]]; then
  echo "rcon password is empty" >&2
  exit 1
fi

python3 - "${COMMAND}" "${RCON_PASSWORD}" <<'PY'
import socket
import struct
import sys

command = sys.argv[1]
password = sys.argv[2]
host = "127.0.0.1"
port = 25575

def send_packet(sock, request_id, packet_type, body):
    payload = struct.pack("<ii", request_id, packet_type) + body.encode("utf-8") + b"\x00\x00"
    sock.sendall(struct.pack("<i", len(payload)) + payload)

def recv_exact(sock, size):
    chunks = []
    remaining = size
    while remaining > 0:
        chunk = sock.recv(remaining)
        if not chunk:
            raise RuntimeError("rcon connection closed")
        chunks.append(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)

def recv_packet(sock):
    packet_length = struct.unpack("<i", recv_exact(sock, 4))[0]
    payload = recv_exact(sock, packet_length)
    request_id, packet_type = struct.unpack("<ii", payload[:8])
    body = payload[8:-2].decode("utf-8", errors="replace")
    return request_id, packet_type, body

with socket.create_connection((host, port), timeout=5) as sock:
    sock.settimeout(1)
    send_packet(sock, 1, 3, password)
    auth_id, _auth_type, _auth_body = recv_packet(sock)
    if auth_id == -1:
        raise RuntimeError("rcon authentication failed")

    send_packet(sock, 2, 2, command)
    responses = []
    try:
      while True:
        response_id, _response_type, response_body = recv_packet(sock)
        if response_id != 2:
            continue
        if response_body:
            responses.append(response_body)
        else:
            break
    except TimeoutError:
      pass
    except socket.timeout:
      pass

    output = "\n".join(part for part in responses if part).strip()
    print(output if output else "(no output)")
PY

echo "STATUS:OK"
